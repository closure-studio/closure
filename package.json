{
  "name": "closure",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo-google-fonts/oxanium": "^0.4.2",
    "@expo/ui": "~57.0.13",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@tamagui/config": "^2.5.1",
    "@tamagui/portal": "^2.5.1",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.16",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.15",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.3.6",
    "lucide-react-native": "^1.26.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.36.5",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.3.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.5.1",
    "valibot": "^1.4.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@tamagui/cli": "^2.5.1",
    "@tamagui/metro-plugin": "^2.5.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "~26.1.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "^1.20.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "resources:sync": "node --experimental-strip-types ./scripts/sync-game-resources.mjs",
    "assets:generate-dashboard": "node --experimental-strip-types ./scripts/generate-dashboard-assets.mjs",
    "assets:check-dashboard": "node --experimental-strip-types ./scripts/generate-dashboard-assets.mjs --check",
    "android": "expo run:android",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "check:updates": "node ./scripts/check-library-updates.mjs",
    "export:all": "expo export --platform all",
    "i18n:check": "node ./scripts/check-translations.mjs",
    "loc": "node ./scripts/audit-loc.mjs",
    "lint": "expo lint --max-warnings 0",
    "postinstall": "node ./scripts/copy-canvaskit.mjs",
    "quality": "npm run tamagui:check && npm run typecheck && npm run lint && npm run i18n:check && npm run assets:check-dashboard && npm run profile:android-ui:test && npm test",
    "profile:android-ui": "node ./scripts/profile-android-ui.mjs",
    "profile:android-ui:test": "node --test ./scripts/android-ui-profile-lib.test.mjs",
    "setup:skia-web": "node ./scripts/copy-canvaskit.mjs",
    "tamagui:check": "tamagui check",
    "tamagui:generate": "tamagui generate",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/tests/mocks/flash-list.tsx"
    ],
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "^react-native-mmkv$": "<rootDir>/tests/mocks/react-native-mmkv.ts"
    },
    "preset": "jest-expo",
    "resolver": "<rootDir>/node_modules/react-native-worklets/jest/resolver.js",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|tamagui|@tamagui|lucide-react-native|immer))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "private": true
}
