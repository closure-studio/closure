# Public URL created by `tailscale funnel` for the local MCP server.
CODING_TOOLS_MCP_SERVER_URL=https://your-device.your-tailnet.ts.net

# Public Linux.do client ID shared by Website, iOS, and Android.
# Production builds fail without it; EAS builds read it from the EAS environment.
EXPO_PUBLIC_LINUXDO_CLIENT_ID=
